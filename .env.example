# Copy to .env.local for development. In production set these in your host's settings
# (Vercel: Project > Settings > Environment Variables). Never commit real values.
# Check what's missing at https://YOUR-SITE/api/health (it shows yes/no, never values).

# --- Required ------------------------------------------------------------------------
# Supabase project (Project Settings > API). The anon/publishable key is public by design;
# row-level security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: used for checkout, payments and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the store, without a trailing slash. Used for canonical URLs,
# the sitemap, emails and sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A long random string (e.g. `openssl rand -hex 32`). Signs guest order links and the
# guest cart cookie. Changing it invalidates links already emailed to guests.
ORDER_LINK_SECRET=

# --- Payments: Razorpay (India) ------------------------------------------------------
# Dashboard > Account & Settings > API Keys. Use rzp_test_ keys until you go live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://YOUR-SITE/api/webhooks/razorpay, any strong secret.
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: Stripe (optional, international cards) --------------------------------
STRIPE_SECRET_KEY=
# Developers > Webhooks: URL https://YOUR-SITE/api/webhooks/stripe,
# events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, refund.updated, charge.refund.updated.
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; without it emails are recorded but not sent) -------------------
# https://resend.com: verify your sending domain, then create an API key.
RESEND_API_KEY=
EMAIL_FROM="Your Store <orders@your-domain.in>"

# --- Courier: Shiprocket (optional) --------------------------------------------------
# Shiprocket > Settings > API > Configure: create an API user (its own email, not your
# login) and put its email and password here. Then turn Shiprocket on in Admin > Shipping.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Any strong random string. In Shiprocket > Settings > API > Webhooks, set the URL to
# https://YOUR-SITE/api/webhooks/courier and paste the same value as the token.
SHIPROCKET_WEBHOOK_TOKEN=

# --- WhatsApp order updates (optional) -----------------------------------------------
# WhatsApp Business Platform (Cloud API) in Meta Business Suite: a system user's permanent
# token with whatsapp_business_messaging, and the sending number's phone number ID.
# Then map approved templates in Admin > Settings > WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0

# --- Scheduled jobs ------------------------------------------------------------------
# Vercel Cron sends this as a bearer token to /api/cron/housekeeping.
CRON_SECRET=

# --- Sign-in -------------------------------------------------------------------------
# Set to 1 after enabling Google in Supabase (Authentication > Providers).
NEXT_PUBLIC_GOOGLE_SIGN_IN=

# --- Local development and tests only ------------------------------------------------
# Point payments at the bundled mock instead of Razorpay (ignored with live keys).
# RAZORPAY_API_BASE=http://localhost:4010
# Point courier bookings at the bundled Shiprocket mock (only localhost addresses are used).
# SHIPROCKET_API_BASE=http://localhost:4011
# Point WhatsApp messages at the bundled mock (only localhost addresses are used).
# WHATSAPP_API_BASE=http://localhost:4012
# For `supabase start` with Google sign-in:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
